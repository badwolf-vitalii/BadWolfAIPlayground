<Window x:Class="BadWolfAIPlayground.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BadWolfAIPlayground.App.Controls"
        xmlns:search="clr-namespace:BadWolfAIPlayground.App.Search"
        Title="BadWolf AI Playground"
        Width="1400" Height="900" MinWidth="1090" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- App navigation -->
        <Border Grid.Column="0" Background="#0C1729" BorderBrush="#233047"
                BorderThickness="0,0,1,0">
            <Grid Margin="22,30,16,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="12" Background="#176CD0">
                            <TextBlock Text="◆" Foreground="White" FontSize="24"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="BADWOLF" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="AI PLAYGROUND" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#64B4FF" />
                        </StackPanel>
                    </StackPanel>
                    <Border Height="1" Margin="0,28,0,23" Background="#27374E" />
                    <TextBlock Text="EXPERIMENTS" FontSize="10" FontWeight="SemiBold"
                               Foreground="#748AA7" Margin="9,0,0,15" />
                    <Button x:Name="NeuralNavButton" Style="{StaticResource NavigationButton}"
                            Background="#17385D" Content="◎   Neural Network Lab"
                            Click="ShowNeuralLab_Click" />
                    <Button x:Name="SmartNavButton" Style="{StaticResource NavigationButton}"
                            Background="#0C1729" Foreground="#B4D5F5" Margin="0,9,0,0"
                            Content="⌕   Smart Search Lab" Click="ShowSmartSearch_Click" />
                    <StackPanel Orientation="Horizontal" Margin="13,23,0,0">
                        <TextBlock Text="⌁" FontSize="24" Foreground="#7187A4" />
                        <TextBlock Text="Anomaly Detection" FontSize="12" Foreground="#899DB8"
                                   Margin="12,4,0,0" />
                    </StackPanel>
                    <TextBlock Text="COMING SOON" FontSize="9" Foreground="#5D738C"
                               Margin="48,0,0,0" />
                </StackPanel>

                <Border Grid.Row="2" Background="#101F34" CornerRadius="12"
                        BorderBrush="#27405E" BorderThickness="1" Padding="13">
                    <StackPanel>
                        <TextBlock Text="LOCAL-FIRST AI" FontSize="10" FontWeight="Bold"
                                   Foreground="#48CEBB" />
                        <TextBlock Text="No API keys. No cloud. Just C# and experiments."
                                   TextWrapping="Wrap" FontSize="12" Margin="0,9,0,9"
                                   Foreground="#A2B8D0" />
                        <TextBlock Text="v0.2.0  ·  .NET 8" FontSize="10"
                                   Foreground="#7088A6" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main content -->
        <ScrollViewer x:Name="NeuralLabContent" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,28,32,30" MaxWidth="1500">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="NEURAL NETWORK LAB" Foreground="#58B5FF"
                                   FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="Learn how a neural network actually works." FontSize="29"
                                   FontWeight="Bold" Margin="0,7,0,5" />
                        <TextBlock Text="One small experiment, four examples, and real results you can compare."
                                   Style="{StaticResource MutedText}" FontSize="13" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#12342F" BorderBrush="#266D61"
                            BorderThickness="1" CornerRadius="12" Padding="13,8"
                            VerticalAlignment="Top" Margin="12,5,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#45E5B7" Margin="0,0,8,0" />
                            <TextBlock Text="100% LOCAL ENGINE" Foreground="#7EE5C6"
                                       FontWeight="SemiBold" FontSize="10" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Guided XOR lesson: explain the goal and next action before the controls. -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,18"
                        Background="#10243B" BorderBrush="#2A6189">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="START HERE" FontSize="11" FontWeight="Bold"
                                           Foreground="#69C1FF" />
                                <TextBlock Text="  ·  GUIDED XOR EXPERIMENT" FontSize="11"
                                           Foreground="#8EB1D0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1B3B59" CornerRadius="7"
                                    Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LessonStepLabel}" FontSize="10"
                                           FontWeight="SemiBold" Foreground="#B6DEFF" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding LessonTitle}" FontSize="21" FontWeight="SemiBold"
                                   Margin="0,12,0,5" />
                        <TextBlock Text="{Binding LessonDescription}" TextWrapping="Wrap"
                                   Foreground="#C5D8ED" FontSize="13" />

                        <!-- Step 1: the entire XOR dataset, with no assumed prior knowledge. -->
                        <UniformGrid Columns="4" Margin="0,16,0,0">
                            <UniformGrid.Style>
                                <Style TargetType="UniformGrid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LessonStep}" Value="1">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </UniformGrid.Style>
                            <Border Background="#162E49" BorderBrush="#36516F" BorderThickness="1"
                                    CornerRadius="8" Padding="10" Margin="0,0,6,0">
                                <TextBlock Text="0 XOR 0  =  0" Foreground="#EAF4FF" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                            </Border>
                            <Border Background="#162E49" BorderBrush="#36516F" BorderThickness="1"
                                    CornerRadius="8" Padding="10" Margin="6,0,6,0">
                                <TextBlock Text="0 XOR 1  =  1" Foreground="#EAF4FF" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                            </Border>
                            <Border Background="#162E49" BorderBrush="#36516F" BorderThickness="1"
                                    CornerRadius="8" Padding="10" Margin="6,0,6,0">
                                <TextBlock Text="1 XOR 0  =  1" Foreground="#EAF4FF" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                            </Border>
                            <Border Background="#162E49" BorderBrush="#36516F" BorderThickness="1"
                                    CornerRadius="8" Padding="10" Margin="6,0,0,0">
                                <TextBlock Text="1 XOR 1  =  0" Foreground="#EAF4FF" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </UniformGrid>

                        <!-- Step 2: preserve an initial baseline instead of comparing to guesses from memory. -->
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LessonStep}" Value="2">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Background="#182F46" CornerRadius="8" Padding="14,10" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="STARTING ACCURACY" FontSize="10" Foreground="#91ABC8" />
                                    <TextBlock Text="{Binding BeforeAccuracyText}" FontSize="21" FontWeight="Bold"
                                               Foreground="#E7F0FF" />
                                </StackPanel>
                            </Border>
                            <Border Background="#182F46" CornerRadius="8" Padding="14,10" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="STARTING LOSS" FontSize="10" Foreground="#91ABC8" />
                                    <TextBlock Text="{Binding BeforeLossText}" FontSize="21" FontWeight="Bold"
                                               Foreground="#E7F0FF" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding BaselineContextText}" FontSize="11"
                                       Foreground="#9DB8D2" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Step 3: a direct action in the lesson, not a hunt for a button elsewhere. -->
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LessonStep}" Value="3">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Content="▶  Train now" Command="{Binding TrainCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,14,0"
                                    ToolTip="Use the experiment settings below and train the XOR network" />
                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#AFC6E0"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Step 4: show real numbers from this session, not illustrative claims. -->
                        <StackPanel Margin="0,16,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LessonStep}" Value="4">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <UniformGrid Columns="3">
                                <Border Background="#182F46" CornerRadius="8" Padding="12,9" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="BEFORE: CORRECT" FontSize="10" Foreground="#91ABC8" />
                                        <TextBlock Text="{Binding BeforeAccuracyText}" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#182F46" CornerRadius="8" Padding="12,9" Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="NOW: CORRECT" FontSize="10" Foreground="#91ABC8" />
                                        <TextBlock Text="{Binding AccuracyText}" FontSize="18" FontWeight="SemiBold"
                                                   Foreground="#55D9BE" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#182F46" CornerRadius="8" Padding="12,9" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="CHANGE IN LOSS" FontSize="10" Foreground="#91ABC8" />
                                        <TextBlock Text="{Binding LossChangeText}" FontSize="14" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <TextBlock Text="{Binding LessonOutcome}" Foreground="#B8E7DA"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>

                        <Border Background="#0B1D31" CornerRadius="8" Padding="12,9"
                                Margin="0,15,0,0">
                            <TextBlock Text="{Binding LessonHint}" Foreground="#B6CDE4"
                                       FontSize="12" TextWrapping="Wrap" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                            <Button Content="←  Previous" Command="{Binding PreviousLessonCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                            <Button Content="{Binding LessonNextLabel}" Command="{Binding NextLessonCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                    ToolTip="At step 3, train at least once before viewing the results" />
                            <Button Content="Restart guide" Command="{Binding RestartLessonCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Rewind the explanation without deleting learned weights" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Visualization + experiment configuration -->
                <Grid Grid.Row="2" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.48*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,9,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Network architecture" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Live connections and learned weights"
                                               Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="7" Padding="9,5"
                                        Background="#1E344D" VerticalAlignment="Top">
                                    <TextBlock Text="2 → H → 1" Foreground="#9DCCFF"
                                               FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <controls:NeuralNetworkView Snapshot="{Binding CurrentSnapshot}"
                                                        Height="265" Margin="0,13,0,0" />
                            <Border Height="1" Background="#283B54" Margin="0,2,0,14" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Width="9" Height="9" Fill="#20C6D8" Margin="0,3,7,0" />
                                <TextBlock Text="Positive weight" FontSize="11"
                                           Style="{StaticResource MutedText}" Margin="0,0,19,0" />
                                <Ellipse Width="9" Height="9" Fill="#B96BFC" Margin="0,3,7,0" />
                                <TextBlock Text="Negative weight" FontSize="11"
                                           Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Experiment settings" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Use the defaults for your first experiment"
                                       Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,18" />
                            <UniformGrid Columns="2" Rows="2">
                                <StackPanel Margin="0,0,9,15">
                                    <TextBlock Text="Hidden neurons" FontSize="11" Margin="0,0,0,6"
                                               Foreground="#AFC5E1" />
                                    <TextBox Text="{Binding HiddenNeuronsText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="How many internal neurons learn patterns." Foreground="#829CB9"
                                               FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Margin="9,0,0,15">
                                    <TextBlock Text="Epochs" FontSize="11" Margin="0,0,0,6"
                                               Foreground="#AFC5E1" />
                                    <TextBox Text="{Binding EpochsText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Passes through all four training examples." Foreground="#829CB9"
                                               FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,9,15">
                                    <TextBlock Text="Learning rate" FontSize="11" Margin="0,0,0,6"
                                               Foreground="#AFC5E1" />
                                    <TextBox Text="{Binding LearningRateText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Size of each weight adjustment." Foreground="#829CB9"
                                               FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Margin="9,0,0,15">
                                    <TextBlock Text="Random seed" FontSize="11" Margin="0,0,0,6"
                                               Foreground="#AFC5E1" />
                                    <TextBox Text="{Binding SeedText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Same seed gives the same initial weights." Foreground="#829CB9"
                                               FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                            </UniformGrid>

                            <CheckBox Content="Watch training live (slower)"
                                      IsChecked="{Binding WatchTraining, Mode=TwoWay}"
                                      Foreground="#C5D8ED" FontSize="11" Margin="0,2,0,14"
                                      ToolTip="Pace live updates so you can see weights and predictions change; uncheck for maximum speed" />
                            <Grid Margin="0,5,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="▶  Train" Command="{Binding TrainCommand}"
                                        ToolTip="Learn XOR by updating neural-network weights"
                                        Style="{StaticResource PrimaryButton}" Margin="0,0,5,0" />
                                <Button Grid.Column="1" Content="Stop" Command="{Binding StopCommand}"
                                        ToolTip="Stop training after the current epoch and keep the weights"
                                        Style="{StaticResource SecondaryButton}" Margin="5,0,5,0" />
                                <Button Grid.Column="2" Content="Reset" Command="{Binding ResetCommand}"
                                        ToolTip="Forget learned weights and start again from a new baseline"
                                        Style="{StaticResource SecondaryButton}" Margin="5,0,0,0" />
                            </Grid>
                            <Border Height="1" Background="#2B3D56" Margin="0,8,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="↓  Save model"
                                        Command="{Binding SaveCommand}" Style="{StaticResource SecondaryButton}"
                                        ToolTip="Save learned weights and network shape as a JSON file"
                                        Margin="0,0,7,0" />
                                <Button Grid.Column="1" Content="↑  Load model"
                                        Command="{Binding LoadCommand}" Style="{StaticResource SecondaryButton}"
                                        ToolTip="Restore a previously trained model from JSON"
                                        Margin="7,0,0,0" />
                            </Grid>
                            <TextBlock Text="Models are stored locally as JSON files."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       FontSize="10" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Loss chart + live metrics -->
                <Grid Grid.Row="3" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.48*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,9,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Training loss" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="MEAN SQUARED ERROR · LOG SCALE"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="#7292B2" FontSize="9" />
                            </Grid>
                            <controls:LossChartView Points="{Binding LossHistory}" Height="158"
                                                    Margin="0,12,0,0" />
                            <TextBlock Text="A lower curve means the model is learning the examples."
                                       Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Live metrics" FontSize="16" FontWeight="SemiBold" />
                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CURRENT LOSS" FontSize="10" Foreground="#8CA4C3" />
                                    <TextBlock Text="{Binding LossText}" FontSize="23" FontWeight="SemiBold"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="CORRECT PREDICTIONS" FontSize="10" Foreground="#8CA4C3" />
                                    <TextBlock Text="{Binding AccuracyText}" FontSize="23" FontWeight="SemiBold"
                                               Foreground="#55D9BE" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,18,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="EPOCHS" FontSize="10" Foreground="#8CA4C3" />
                                <TextBlock Grid.Column="1" Text="{Binding EpochText}" FontSize="11"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Completion, Mode=OneWay}"
                                         Height="7" Foreground="#3E9BFF" Background="#192A43"
                                         BorderThickness="0" />
                            <TextBlock Text="{Binding StatusText}" Foreground="#A5BDD7"
                                       TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Test predictions -->
                <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Compare the four XOR predictions" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Before = saved starting guess; now = current model; target = correct answer"
                                           Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#183A36" CornerRadius="7"
                                    Padding="10,5" VerticalAlignment="Top">
                                <TextBlock Text="LIVE INFERENCE" Foreground="#68DCC1" FontSize="10" />
                            </Border>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Predictions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0A172A" BorderBrush="#29415E"
                                            BorderThickness="1" CornerRadius="11"
                                            Padding="14" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Input}" FontSize="13" FontWeight="SemiBold" />
                                            <Grid Margin="0,13,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="NOW" Foreground="#8DA6C3" FontSize="9" />
                                                <TextBlock Grid.Column="1" Text="{Binding Output}"
                                                           Foreground="#67C6FF" FontWeight="Bold" FontSize="14" />
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="100"
                                                         Value="{Binding Percentage, Mode=OneWay}" Height="7"
                                                         Background="#1B2C45" Foreground="#31B7DA"
                                                         BorderThickness="0" />
                                            <Grid Margin="0,9,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="BEFORE" Foreground="#819BB7" FontSize="10" />
                                                <TextBlock Grid.Column="1" Text="{Binding BeforeOutput}"
                                                           Foreground="#CBD8EB" FontSize="11" />
                                            </Grid>
                                            <TextBlock Text="{Binding ChangeDescription}" FontSize="10"
                                                       Foreground="#7BCFBA" Margin="0,5,0,0" />
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="10" Foreground="#9AAEC8">
                                                    <Run Text="Expected: " />
                                                    <Run Text="{Binding Expected, Mode=OneWay}" />
                                                </TextBlock>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Result}" Foreground="#D5E7FF" FontSize="10" />
                                                    <TextBlock Text="  ·  " Foreground="#8DA6C3" FontSize="10" />
                                                    <TextBlock Text="{Binding ResultDescription}" Foreground="#B8E7DA" FontSize="10" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

